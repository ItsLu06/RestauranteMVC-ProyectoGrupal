@model RestauranteMVC.Models.Empleado

<div asp-validation-summary="ModelOnly"></div>
    <div class="mb-3">
        <label asp-for="Nombre" class="form-label"></label>
        <input asp-for="Nombre" class="form-control" autofocus />
        <span asp-validation-for="Nombre" class="field-validation-error"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Apellido" class="form-label"></label>
        <input asp-for="Apellido" class="form-control" />
        <span asp-validation-for="Apellido" class="field-validation-error"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Telefono" class="form-label"></label>
        <input asp-for="Telefono" type="tel" class="form-control" placeholder="Opcional" />
        <span asp-validation-for="Telefono" class="field-validation-error"></span>
    </div>
    <div class="mb-3">
        <label asp-for="CargoId" class="form-label"></label>
        <select asp-for="CargoId" asp-items="ViewBag.Cargos" class="form-select">
            <option value="">Selecciona un cargo…</option>
        </select>
        <div class="form-text">¿No aparece el cargo? <a asp-controller="Cargos" asp-action="Create">Crea uno nuevo</a>.</div>
        <span asp-validation-for="CargoId" class="field-validation-error"></span>
    </div>

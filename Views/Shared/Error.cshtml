@model ErrorViewModel
@{
    ViewData["Title"] = Model.Titulo;
}

<div class="error-box">
    <div class="error-code">@Model.Codigo</div>
    <h1 class="h3 mt-2">@Model.Titulo</h1>
    <p class="text-secondary">@Model.Mensaje</p>
    <a asp-controller="Home" asp-action="Index" class="btn btn-primary mt-2">@Html.Icono("home") Volver al tablero</a>
    @if (Model.ShowRequestId)
    {
        <p class="mt-4 small text-secondary">Código de referencia: <code>@Model.RequestId</code></p>
    }
</div>

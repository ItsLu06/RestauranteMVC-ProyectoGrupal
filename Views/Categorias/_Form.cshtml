@model RestauranteMVC.Models.Categoria

<div asp-validation-summary="ModelOnly"></div>
    <div class="mb-3">
        <label asp-for="Nombre" class="form-label"></label>
        <input asp-for="Nombre" class="form-control" autofocus placeholder="Ej. Bebidas" />
        <span asp-validation-for="Nombre" class="field-validation-error"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Descripcion" class="form-label"></label>
        <textarea asp-for="Descripcion" class="form-control" rows="3" placeholder="Opcional"></textarea>
        <span asp-validation-for="Descripcion" class="field-validation-error"></span>
    </div>

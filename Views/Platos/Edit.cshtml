@model RestauranteMVC.Models.Plato
@{
    ViewData["Title"] = "Editar plato";
}

<a asp-action="Index" class="crumb">@Html.Icono("back") Platos</a>
<div class="page-head">
    <div><h1>Editar plato</h1></div>
</div>

<div class="card-x form-card">
    <div class="card-pad">
        <form asp-action="Edit" asp-route-id="@Model.Id">
            <input type="hidden" asp-for="Id" />
            <partial name="_Form" model="Model" />
            <div class="form-actions">
                <button type="submit" class="btn btn-primary">Guardar cambios</button>
                <a asp-action="Index" class="btn btn-light">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

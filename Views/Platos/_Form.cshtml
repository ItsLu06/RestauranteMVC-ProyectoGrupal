@model RestauranteMVC.Models.Plato

<div asp-validation-summary="ModelOnly"></div>
    <div class="mb-3">
        <label asp-for="Nombre" class="form-label"></label>
        <input asp-for="Nombre" class="form-control" autofocus placeholder="Ej. Silpancho" />
        <span asp-validation-for="Nombre" class="field-validation-error"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Precio" class="form-label"></label>
        <div class="input-group">
            <span class="input-group-text">Bs</span>
            <input asp-for="Precio" type="number" step="0.01" min="0.01" inputmode="decimal" class="form-control" value="@(Model.Precio > 0 ? Model.Precio.ToString(System.Globalization.CultureInfo.InvariantCulture) : "")" />
        </div>
        <span asp-validation-for="Precio" class="field-validation-error"></span>
    </div>
    <div class="mb-3">
        <label asp-for="CategoriaId" class="form-label"></label>
        <select asp-for="CategoriaId" asp-items="ViewBag.Categorias" class="form-select">
            <option value="">Selecciona una categoría…</option>
        </select>
        <div class="form-text">¿No aparece? <a asp-controller="Categorias" asp-action="Create">Crea una categoría</a>.</div>
        <span asp-validation-for="CategoriaId" class="field-validation-error"></span>
    </div>
    <div class="form-check form-switch mb-1">
        <input asp-for="Disponible" class="form-check-input" role="switch" />
        <label asp-for="Disponible" class="form-check-label">Disponible para pedir</label>
    </div>

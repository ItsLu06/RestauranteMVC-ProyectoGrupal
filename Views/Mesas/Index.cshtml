@model IEnumerable<RestauranteMVC.Models.Mesa>
@{
    ViewData["Title"] = "Mesas";
}

<div class="page-head">
    <div>
        <h1>Mesas</h1>
        <p>Mesas del salón y su estado actual.</p>
    </div>
    <div class="page-actions">
        <a asp-action="Create" class="btn btn-primary">@Html.Icono("plus") Nueva mesa</a>
    </div>
</div>

<div class="card-x">
    @if (!Model.Any())
    {
        <div class="empty">
            @Html.Icono("grid")
            <h3>Aún no hay mesas</h3>
            <p>Registra las mesas de tu salón para empezar a tomar pedidos.</p>
            <a asp-action="Create" class="btn btn-primary">@Html.Icono("plus") Nueva mesa</a>
        </div>
    }
    else
    {
        <div class="tbl-wrap">
            <table class="tbl tbl-stack">
                <thead>
                    <tr><th>Mesa</th><th>Capacidad</th><th>Estado</th><th class="actions"></th></tr>
                </thead>
                <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td data-label="Mesa" class="cell-title">Mesa @item.NumeroMesa</td>
                        <td data-label="Capacidad">@item.Capacidad personas</td>
                        <td data-label="Estado"><span class="badge-x @Formato.ClaseEstadoMesa(item.Estado)">@item.Estado</span></td>
                        <td class="actions"><div class="row-actions">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-light btn-icon" title="Ver" aria-label="Ver">@Html.Icono("eye")</a>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-light btn-icon" title="Editar" aria-label="Editar">@Html.Icono("edit")</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger btn-icon" title="Eliminar" aria-label="Eliminar">@Html.Icono("trash")</a>
                        </div></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>

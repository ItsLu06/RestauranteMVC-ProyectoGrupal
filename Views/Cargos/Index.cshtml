@model IEnumerable<RestauranteMVC.Models.Cargo>
@{
    ViewData["Title"] = "Cargos";
}

<div class="page-head">
    <div>
        <h1>Cargos</h1>
        <p>Puestos de trabajo del restaurante.</p>
    </div>
    <div class="page-actions">
        <a asp-action="Create" class="btn btn-primary">@Html.Icono("plus") Nuevo cargo</a>
    </div>
</div>

<div class="card-x">
    @if (!Model.Any())
    {
        <div class="empty">
            @Html.Icono("briefcase")
            <h3>Aún no hay cargos</h3>
            <p>Crea cargos como Mesero, Cocinero o Cajero para asignarlos a tus empleados.</p>
            <a asp-action="Create" class="btn btn-primary">@Html.Icono("plus") Nuevo cargo</a>
        </div>
    }
    else
    {
        <div class="tbl-wrap">
            <table class="tbl tbl-stack">
                <thead>
                    <tr><th>Cargo</th><th>Empleados</th><th class="actions"></th></tr>
                </thead>
                <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td data-label="Cargo" class="cell-title">@item.NombreCargo</td>
                        <td data-label="Empleados">@item.Empleados.Count</td>
                        <td class="actions"><div class="row-actions">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-light btn-icon" title="Ver" aria-label="Ver">@Html.Icono("eye")</a>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-light btn-icon" title="Editar" aria-label="Editar">@Html.Icono("edit")</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger btn-icon" title="Eliminar" aria-label="Eliminar">@Html.Icono("trash")</a>
                        </div></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>
